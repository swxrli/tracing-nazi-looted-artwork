            </map>
            <map to='#d7ccc8'>
              <bucket>&quot;(Baruch-Levy) Paris&quot;</bucket>
            </map>
            <map to='#d7ccc8'>
              <bucket>&quot;(CAronstein) Schaerbeek-Bruxelles, Belgique&quot;</bucket>
            </map>
            <map to='#d7ccc8'>
              <bucket>&quot;(DelaMeurthe) Paris/Chateau d&apos;Angervilliers&quot;</bucket>
            </map>
