            </map>
            <map to='#a1887f'>
              <bucket>&quot;(ZUN) M. Zun, Paris&quot;</bucket>
            </map>
            <map to='#a65e3f'>
              <bucket>&quot;(ALevy) Paris&quot;</bucket>
