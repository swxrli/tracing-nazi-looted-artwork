            </map>
            <map to='#a65e3f'>
              <bucket>&quot;(JBernheim) Paris&quot;</bucket>
            </map>
            <map to='#a65e3f'>
              <bucket>&quot;(JvanHenkel-Geukes) Apeldoorn, The Netherlands--The Tibetan paintings lost by van Henkel-Geukes were about to be sold to a Norwegian citizen who killed during an air raid in Hamburg, according to an OSS report dated 23 August 1945.&quot;</bucket>
            </map>
            <map to='#a65e3f'>
              <bucket>&quot;(LAM) Lambert&quot;</bucket>
            </map>
