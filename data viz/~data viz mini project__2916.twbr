              <bucket>&quot;(Kra) Galerie Krämer&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(Li) Alfred Lindenbaum&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(MA-ASI) Möbel-Aktion Asiatisches&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(Marcus) Marcus&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(MLBernheim) Paris&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(OKlein) Paris&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(Prg.) Porges&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(ROS-FA) The objects belonging to the Rosengart-Famel family were forcibly removed from their residence beginning in early 1942 and ending in March 1943.&quot;</bucket>
            </map>
            <map to='#d2b477'>
              <bucket>&quot;(SKoechlin) Paris&quot;</bucket>
            </map>
