            <map to='#a1887f'>
              <bucket>&quot;(AHoffman) Forest-Bruxelles, Belgique-The Gestapo arrested Mr. Hoffman on 15 March 1942. His apartment was emptied on 18 March 1942.&quot;</bucket>
            </map>
            <map to='#a1887f'>
              <bucket>&quot;(Bal) H. Fa. Ball (Riesener)&quot;</bucket>
            </map>
            <map to='#a1887f'>
